WIFI_SSID = <Your WiFi SSID>
WIFI_PASS = <Your WiFi Password>
BACKEND_IP = <Your Backend IP Address>
BACKEND_PORT = 8080

# Host USB serial device exposed to the backend container.
# Set to /dev/ttyACM0 (or /dev/ttyUSB0) when the board is plugged in,
# /dev/null when it is not, so docker-compose still starts.
SERIAL_PORT = /dev/null
# PostgreSQL (deploy/docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bawal_vision
POSTGRES_PORT=5433
