WIFI_SSID = <Your WiFi SSID>
WIFI_PASS = <Your WiFi Password>
BACKEND_IP = <Your Backend IP Address>
BACKEND_PORT = 8080

# LAN Mode (0 = bind 127.0.0.1, 1 = bind 0.0.0.0 for ESP32 LAN communication)
BAWAL_LAN_MODE = 0

# Shared tokens for local device & admin authentication (run `just setup` to generate)
BAWAL_DEVICE_TOKEN = <generated_device_token_hex>
BAWAL_ADMIN_TOKEN = <generated_admin_token_hex>

# Optional: override the LaTeX audit template used by the report endpoints.
# BAWAL_REPORT_TEMPLATE = ./services/templates/inspection_report.tex.in

# Host USB serial device exposed to the backend container.
# Set to /dev/ttyACM0 (or /dev/ttyUSB0) when the board is plugged in,
# /dev/null when it is not, so docker-compose still starts.
SERIAL_PORT = /dev/null

# PostgreSQL (deploy/docker-compose.yml)
POSTGRES_USER = postgres
POSTGRES_PASSWORD = <generated_postgres_password>
POSTGRES_DB = bawal_vision
POSTGRES_PORT = 5433

# Grafana Admin Password
GRAFANA_ADMIN_USER = admin
GRAFANA_ADMIN_PASSWORD = <generated_grafana_password>
GRAFANA_PORT = 3002

# Shared bearer token for the AWS Lambda Function URL / API Gateway.
# Must match BAWAL_LAMBDA_AUTH_TOKEN in the Lambda environment.
BAWAL_LAMBDA_AUTH_TOKEN = <generated_lambda_token_hex>

# Camera relay (see relay/README.md). The ESP32 publishes JPEG frames over WSS
# so the HTTPS dashboard can watch without LAN/mixed-content restrictions.
# The reference deployment is an Oracle Cloud Always Free VM running
# deploy/docker-compose.relay.yml (Caddy obtains the TLS certificate).
CAMERA_RELAY_URL = https://<relay-domain>
CAMERA_RELAY_FPS = 15
CAMERA_RELAY_DEVICE = default
# Public hostname for Caddy on the relay VM, e.g. relay.<public-ip>.nip.io
RELAY_DOMAIN = <relay-domain>
# Must match RELAY_INGEST_KEY on the relay. Generated by `just setup`.
RELAY_INGEST_KEY = <generated_relay_ingest_key>
# Optional: require browsers to pass this view-only key.
# RELAY_VIEW_KEY = <optional_view_key>

# Browser-side relay settings (set these in Vercel as PUBLIC_* env vars).
PUBLIC_CAMERA_RELAY_URL = https://<relay-domain>
PUBLIC_CAMERA_RELAY_DEVICE = default
# PUBLIC_CAMERA_RELAY_VIEW_KEY = <optional_view_key>

# AWS Lambda Remote Inference Configuration (Local Agent -> Lambda)
# BAWAL_LAMBDA_ENDPOINT = https://<function-id>.lambda-url.<region>.on.aws/api/v1/lambda/inspect
# BAWAL_LAMBDA_REQUIRED = 0
# BAWAL_AWS_SIGV4 = 0

# Grafana Security
# GRAFANA_AUTH_ANONYMOUS_ENABLED = false
