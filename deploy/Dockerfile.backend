# ==============================================================================
# BawalVision C++ Crow backend + in-process ONNX vision pipeline
# Builder: Ubuntu 24.04 LTS (GCC 14, C++20 <format> support)
# Runtime: Ubuntu 24.04 LTS (runtime libraries only)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: compile the unified bawal_backend binary
# ------------------------------------------------------------------------------
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        pkg-config \
        ca-certificates \
        curl \
        unzip \
        libopencv-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libpq-dev \
        libfmt-dev \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# ONNX Runtime is not packaged by Debian; install the official CPU release.
# Supports both x86_64 (amd64) and AWS Graviton / ARM64 (aarch64).
ARG TARGETARCH
ARG ONNXRUNTIME_VERSION=1.19.2
RUN mkdir -p /opt/onnxruntime && \
    ARCH=$(case "${TARGETARCH:-amd64}" in arm64|aarch64) echo "aarch64" ;; *) echo "x64" ;; esac) && \
    curl -fsSL "https://github.com/microsoft/onnxruntime/releases/download/v${ONNXRUNTIME_VERSION}/onnxruntime-linux-${ARCH}-${ONNXRUNTIME_VERSION}.tgz" \
        | tar -xz -C /opt/onnxruntime --strip-components=1

WORKDIR /src

# Only the sources actually compiled into bawal_core are copied. The ML
# generator implementation is omitted because it needs std::format (GCC 13+);
# CMake substitutes the no-op stub when BAWAL_ENABLE_NCNN_GENERATOR=OFF.
COPY services/ /src/services/
COPY ml/include/ /src/ml/include/

RUN cmake -S /src/services -B /src/services/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DBAWAL_BUILD_VISION_VIEWER=OFF \
        -DBAWAL_ENABLE_NCNN_GENERATOR=OFF \
        -DONNXRUNTIME_INCLUDE_DIR=/opt/onnxruntime/include \
        -DONNXRUNTIME_LIB=/opt/onnxruntime/lib/libonnxruntime.so \
    && cmake --build /src/services/build --parallel "$(nproc)"

# ------------------------------------------------------------------------------
# Stage 2: minimal runtime
# ------------------------------------------------------------------------------
FROM ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        unzip \
        libcurl4t64 \
        libssl3t64 \
        libpq5 \
        libgomp1 \
        libfmt9 \
        libopencv-core406t64 \
        libopencv-imgproc406t64 \
        libopencv-calib3d406t64 \
        libopencv-imgcodecs406t64 \
        libopencv-videoio406t64 \
        libopencv-dnn406t64 \
        network-manager \
        texlive-latex-base \
        texlive-latex-recommended \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/onnxruntime/lib/ /usr/local/lib/
RUN ldconfig

WORKDIR /app

COPY --from=builder /src/services/build/bin/bawal_backend /app/bawal_backend

# LaTeX audit templates resolved by LatexPdfGenerator (/app/services/templates).
COPY --from=builder /src/services/templates/ /app/services/templates/

# Pre-packaged INT8 ONNX model for out-of-the-box YOLO inference
COPY ml/AI1/model/yolov8s_int8/ai1_vision_int8.onnx /app/ml/AI1/model/yolov8s_int8/ai1_vision_int8.onnx

ENV LD_LIBRARY_PATH=/usr/local/lib \
    PORT=8080 \
    CROW_PORT=8080 \
    OMP_WAIT_POLICY=PASSIVE \
    OMP_SCHEDULE=static \
    OMP_PROC_BIND=true

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8080}/api/v1/health || exit 1

EXPOSE 8080

CMD ["./bawal_backend"]
