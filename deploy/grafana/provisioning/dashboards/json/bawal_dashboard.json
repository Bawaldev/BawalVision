          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT i.created_at AS \"Waktu Inferensi\", fi.name AS \"Item Makanan (Class)\", CONCAT(ROUND(ifo.similarity_rate * 100, 1), '%') AS \"Confidence Score\", CONCAT(ifo.spoilage_score, '%') AS \"Tingkat Kebusukan\", ifo.status AS \"Status Deteksi\", i.device_id AS \"Camera Source\" FROM inspection_foods ifo JOIN inspections i ON ifo.inspection_id = i.id JOIN food_items fi ON ifo.food_item_id = fi.id WHERE $__timeFilter(i.created_at) ORDER BY i.created_at DESC LIMIT 50;",
          "refId": "A"
        }
      ],
      "title": "Log Real-Time Inferensi Model AI (YOLOv8 & Food CV)",
      "type": "table"
