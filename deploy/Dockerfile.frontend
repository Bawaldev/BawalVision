# ==============================================================================
# BawalVision SCADA & Machine Vision HMI Frontend
# Stack: SvelteKit 5 + TypeScript + Vite + Node.js 22 Alpine
# ==============================================================================

# --- Stage 1: Build Environment ---
FROM node:25-alpine AS builder

WORKDIR /app

# Copy dependency manifests (lockfile optional)
COPY frontend/package.json ./
COPY frontend/package-lock.json* ./

# Install dependencies: use npm ci if lockfile exists, otherwise npm install
RUN if [ -f package-lock.json ]; then \
        echo ">>> Using npm ci (lockfile found)"; \
        npm ci --legacy-peer-deps; \
    else \
        echo ">>> No lockfile found, using npm install"; \
        npm install --legacy-peer-deps; \
    fi

# Copy frontend source code
COPY frontend/ ./

# Compile SvelteKit production build
RUN npm run build

# --- Stage 2: Hardened Production Runtime ---
FROM node:25-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000

# Copy only what's needed to run the production preview
COPY --chown=node:node --from=builder /app/package.json ./
COPY --chown=node:node --from=builder /app/package-lock.json* ./
COPY --chown=node:node --from=builder /app/node_modules ./node_modules
COPY --chown=node:node --from=builder /app/.svelte-kit ./.svelte-kit
COPY --chown=node:node --from=builder /app/static ./static
COPY --chown=node:node --from=builder /app/src ./src
COPY --chown=node:node --from=builder /app/vite.config.ts ./
COPY --chown=node:node --from=builder /app/tsconfig.json ./
COPY --chown=node:node --from=builder /app/svelte.config.js* ./

USER node

EXPOSE 3000

CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "3000"]