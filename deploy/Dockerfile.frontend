# ==============================================================================
# BawalVision SCADA & Machine Vision HMI Frontend
# Stack: SvelteKit 5 + TypeScript + adapter-node + Node.js 22 Alpine
# ==============================================================================

# --- Stage 1: Build Environment ---
FROM node:26-alpine AS builder

WORKDIR /app

# Copy dependency manifests (lockfile optional)
COPY frontend/package.json ./
COPY frontend/package-lock.json* ./

# Install dependencies
RUN if [ -f package-lock.json ]; then \
        echo ">>> Using npm ci (lockfile found)"; \
        npm ci --legacy-peer-deps --include=dev; \
    else \
        echo ">>> No lockfile found, using npm install"; \
        npm install --legacy-peer-deps --include=dev; \
    fi

# Copy frontend source code
COPY frontend/ ./

# Compile SvelteKit production build with adapter-node
ENV ADAPTER=node
RUN npm run build

# --- Stage 2: Hardened Production Runtime (node build) ---
FROM node:26-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000

# Copy only the compiled standalone node server and runtime dependencies
COPY --chown=node:node --from=builder /app/package.json ./
COPY --chown=node:node --from=builder /app/package-lock.json* ./
COPY --chown=node:node --from=builder /app/node_modules ./node_modules
COPY --chown=node:node --from=builder /app/build ./build

USER node

EXPOSE 3000

CMD ["node", "build/index.js"]
