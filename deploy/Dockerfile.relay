# ==============================================================================
# BawalVision camera relay container image
#
# Build context is the repository root:
#   docker build -f deploy/Dockerfile.relay -t bawal-camera-relay .
#
# The relay only needs the Node runtime, package.json, and server.js.
# ==============================================================================
FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production

COPY relay/package.json ./
RUN npm install --omit=dev --no-audit --no-fund

COPY relay/server.js ./

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:${PORT:-8080}/health >/dev/null || exit 1

CMD ["node", "server.js"]
