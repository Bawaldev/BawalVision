# ==============================================================================
# BawalVision Machine Vision, ONNX ML & NCNN Super-Resolution Engine
# Language: C++20 (OpenCV, ONNX Runtime, NCNN, OpenMP, CMake, Ninja)
# Target OS: Ubuntu 24.04 LTS
#
# Deployment target: AWS Lambda (CPU-only, x86_64, AVX2/AVX-512).
# No GPU, no Vulkan. NCNN runs on CPU with AVX2 and OpenMP.
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build environment
# ------------------------------------------------------------------------------
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# ------------------------------------------------------------------------------
# 1. Build dependencies
# ------------------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    libopencv-dev \
    libcurl4-openssl-dev \
    libomp-dev \
    nlohmann-json3-dev \
    ca-certificates \
    curl \
    wget \
    tar \
    unzip && \
    # --------------------------------------------------------------------------
    # 2. ONNX Runtime v1.19.2 (for YOLOv8 food classifier)
    # --------------------------------------------------------------------------
    mkdir -p /opt/onnxruntime && \
    curl -fsSL https://github.com/microsoft/onnxruntime/releases/download/v1.19.2/onnxruntime-linux-x64-1.19.2.tgz | \
        tar -xz -C /opt/onnxruntime --strip-components=1 && \
    cp -r /opt/onnxruntime/include/* /usr/local/include/ && \
    cp -r /opt/onnxruntime/lib/* /usr/local/lib/ && \
    # --------------------------------------------------------------------------
    # 3. NCNN 20240410 (CPU-only build; Vulkan is not used in Lambda)
    # --------------------------------------------------------------------------
    mkdir -p /opt/ncnn /tmp/ncnn_extracted && \
    curl -fsSL https://github.com/Tencent/ncnn/releases/download/20240410/ncnn-20240410-ubuntu-2204.zip \
        -o /tmp/ncnn.zip && \
    unzip -q /tmp/ncnn.zip -d /tmp/ncnn_extracted && \
    cp -r /tmp/ncnn_extracted/ncnn-20240410-ubuntu-2204/* /opt/ncnn/ && \
    cp -r /opt/ncnn/include/* /usr/local/include/ && \
    cp -r /opt/ncnn/lib/* /usr/local/lib/ && \
    rm -rf /tmp/ncnn.zip /tmp/ncnn_extracted && \
    ldconfig

WORKDIR /src

# ------------------------------------------------------------------------------
# 4. Compile the NCNN model generator utility
# ------------------------------------------------------------------------------
COPY ml/ /src/ml/
RUN mkdir -p /app/weights && \
    g++ -std=c++20 -O3 -I /src/ml/include \
        /src/ml/src/ncnn_generator.cpp \
        /src/ml/ncnn_generator.cpp \
        -o /usr/local/bin/ncnn_generator

# ------------------------------------------------------------------------------
# 5. Fetch or synthesize RealESRGAN model via scripts/fetch_ncnn_model.sh
# ------------------------------------------------------------------------------
COPY scripts/ /src/scripts/
RUN chmod +x /src/scripts/fetch_ncnn_model.sh && \
    ALLOW_SYNTHETIC_FALLBACK=1 /src/scripts/fetch_ncnn_model.sh \
        realesr-general-x4v3 \
        /app/weights \
        /usr/local/bin/ncnn_generator \
        4

# ------------------------------------------------------------------------------
# 6. Compile the main vision service binary
#
#    -O3        : aggressive optimization
#    -mavx2     : AVX2 vectorization (guaranteed on AWS Lambda x86_64)
#    -mfma      : fused multiply-add
#    -fopenmp   : multithreading for ISP, NCNN, and YOLO preprocessing
#    -flto      : link-time optimization (~10% speedup)
#    -funroll-loops : small loop unrolling
# ------------------------------------------------------------------------------
COPY services/ /src/services/

RUN cmake -B /src/services/build -S /src/services -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_FLAGS="-O3 -mavx2 -mfma -fopenmp -flto -funroll-loops" \
    -DCMAKE_EXE_LINKER_FLAGS="-flto" \
    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && \
    cmake --build /src/services/build --parallel $(nproc)


# ------------------------------------------------------------------------------
# Stage 2: Production runtime (CPU-only)
# ------------------------------------------------------------------------------
FROM ubuntu:24.04 AS runner

ENV DEBIAN_FRONTEND=noninteractive

# ------------------------------------------------------------------------------
# 7. Runtime libraries only
#
#    No Vulkan packages. Lambda has no GPU, so Vulkan would only add
#    image size and startup time without providing any benefit.
# ------------------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    libopencv-dev \
    libcurl4 \
    libgomp1 \
    ca-certificates \
    && useradd -m -s /bin/bash -u 1001 visionuser \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ------------------------------------------------------------------------------
# 8. Copy shared libraries (ONNX Runtime + NCNN)
# ------------------------------------------------------------------------------
COPY --from=builder /opt/onnxruntime/lib/ /usr/local/lib/
COPY --from=builder /usr/local/lib/libncnn* /usr/local/lib/
RUN ldconfig

# ------------------------------------------------------------------------------
# 9. Copy the binary, the generator utility, and model weights
# ------------------------------------------------------------------------------
COPY --from=builder /src/services/build/bin/vision_service /usr/local/bin/vision_service
COPY --from=builder /usr/local/bin/ncnn_generator /usr/local/bin/ncnn_generator
COPY --from=builder /app/weights/ /app/weights/

# ------------------------------------------------------------------------------
# 10. Prepare directories and ownership
# ------------------------------------------------------------------------------
RUN mkdir -p /app/ml/AI1/model /app/weights && \
    chown -R visionuser:visionuser /app && \
    echo "[INFO] Model weights in image:" && \
    ls -la /app/weights/

# ------------------------------------------------------------------------------
# 11. Runtime environment (CPU-only)
#
#    OMP_NUM_THREADS is set conservatively. AWS Lambda typically provides
#    2-6 vCPU depending on memory configuration. NCNN reads
#    ncnn::get_big_cpu_count() and adjusts at runtime.
# ------------------------------------------------------------------------------
ENV OMP_NUM_THREADS=4 \
    OMP_SCHEDULE=static \
    OMP_PROC_BIND=true \
    OMP_WAIT_POLICY=PASSIVE \
    LD_LIBRARY_PATH=/usr/local/lib:/opt/onnxruntime/lib \
    HEADLESS=1 \
    QT_QPA_PLATFORM=offscreen

USER visionuser

EXPOSE 8080

ENTRYPOINT ["vision_service"]