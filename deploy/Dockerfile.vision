# ==============================================================================
# BawalVision Machine Vision, ONNX ML & NCNN Super-Resolution Engine
# Language: C++20 (OpenCV, ONNX Runtime, NCNN, OpenMP, CMake, Ninja)
# Target OS: Ubuntu 24.04 LTS (Optimized with AVX2 & OpenMP Multithreading)
# ==============================================================================

# --- Stage 1: Build Environment ---
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# ------------------------------------------------------------------------------
# 1. Install build dependencies: OpenCV, NCNN, Vulkan, ONNX Runtime, dll.
# ------------------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    libopencv-dev \
    libcurl4-openssl-dev \
    libomp-dev \
    nlohmann-json3-dev \
    libvulkan-dev \
    glslang-tools \
    ca-certificates \
    curl \
    wget \
    tar \
    unzip && \
    # --------------------------------------------------------------------------
    # 2. Install ONNX Runtime v1.19.2 (untuk YOLOv8 classifier)
    # --------------------------------------------------------------------------
    mkdir -p /opt/onnxruntime && \
    curl -fsSL https://github.com/microsoft/onnxruntime/releases/download/v1.19.2/onnxruntime-linux-x64-1.19.2.tgz | tar -xz -C /opt/onnxruntime --strip-components=1 && \
    cp -r /opt/onnxruntime/include/* /usr/local/include/ && \
    cp -r /opt/onnxruntime/lib/* /usr/local/lib/ && \
    # --------------------------------------------------------------------------
    # 3. Install NCNN 20240410 (untuk RealESRGAN super-resolution)
    # --------------------------------------------------------------------------
    mkdir -p /opt/ncnn /tmp/ncnn_extracted && \
    curl -fsSL https://github.com/Tencent/ncnn/releases/download/20240410/ncnn-20240410-ubuntu-2204.zip -o /tmp/ncnn.zip && \
    unzip -q /tmp/ncnn.zip -d /tmp/ncnn_extracted && \
    cp -r /tmp/ncnn_extracted/ncnn-20240410-ubuntu-2204/* /opt/ncnn/ && \
    cp -r /opt/ncnn/include/* /usr/local/include/ && \
    cp -r /opt/ncnn/lib/* /usr/local/lib/ && \
    rm -rf /tmp/ncnn.zip /tmp/ncnn_extracted && \
    ldconfig

WORKDIR /src

# ------------------------------------------------------------------------------
# 4. Compile modular NCNN model generator
# ------------------------------------------------------------------------------
COPY ml/ /src/ml/
RUN mkdir -p /app/weights && \
    g++ -std=c++20 -O3 -I /src/ml/include \
        /src/ml/src/ncnn_generator.cpp \
        /src/ml/ncnn_generator.cpp \
        -o /usr/local/bin/ncnn_generator

# ------------------------------------------------------------------------------
# 5. DOWNLOAD REAL RealESRGAN x2 NCNN MODEL (bukan model sintetis!)
# ------------------------------------------------------------------------------
# Strategi: coba beberapa sumber, verifikasi ukuran, fallback ke generator sintetis.
RUN set -eux; \
    PARAM_URLS=" \
        https://raw.githubusercontent.com/xinntao/Real-ESRGAN-ncnn-vulkan/master/models/realesr-animevideov3-x2.param \
        https://raw.githubusercontent.com/ai-forever/Real-ESRGAN/main/experiments/pretrained_models/realesr-animevideov3-x2.param \
        https://raw.githubusercontent.com/nihui/realsr-ncnn-vulkan/master/models/realesr-animevideov3-x2.param \
    "; \
    BIN_URLS=" \
        https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.5.0/realesr-animevideov3-x2.bin \
        https://github.com/nihui/realsr-ncnn-vulkan/releases/download/20220424/realesr-animevideov3-x2.bin \
    "; \
    \
    echo "[INFO] Mencoba mengunduh file .param..."; \
    PARAM_OK=0; \
    for url in $PARAM_URLS; do \
        echo "[INFO] Mencoba: $url"; \
        if curl -fsSL --connect-timeout 15 --max-time 60 -o /tmp/model.param "$url"; then \
            SIZE=$(stat -c%s /tmp/model.param 2>/dev/null || echo 0); \
            if [ "$SIZE" -gt 1000 ]; then \
                echo "[SUCCESS] .param berhasil diunduh dari $url (ukuran: $SIZE bytes)"; \
                cp /tmp/model.param /app/weights/realesr-animevideov3-x2.param; \
                PARAM_OK=1; \
                break; \
            else \
                echo "[WARN] File terlalu kecil ($SIZE bytes), coba sumber lain"; \
            fi; \
        fi; \
    done; \
    \
    echo "[INFO] Mencoba mengunduh file .bin..."; \
    BIN_OK=0; \
    for url in $BIN_URLS; do \
        echo "[INFO] Mencoba: $url"; \
        if curl -fsSL --connect-timeout 15 --max-time 300 -o /tmp/model.bin "$url"; then \
            SIZE=$(stat -c%s /tmp/model.bin 2>/dev/null || echo 0); \
            if [ "$SIZE" -gt 500000 ]; then \
                echo "[SUCCESS] .bin berhasil diunduh dari $url (ukuran: $SIZE bytes)"; \
                cp /tmp/model.bin /app/weights/realesr-animevideov3-x2.bin; \
                BIN_OK=1; \
                break; \
            else \
                echo "[WARN] File terlalu kecil ($SIZE bytes), coba sumber lain"; \
            fi; \
        fi; \
    done; \
    \
    # --------------------------------------------------------------------------
    # 6. Fallback: jika download gagal, gunakan generator sintetis
    # --------------------------------------------------------------------------
    if [ "$PARAM_OK" -eq 0 ] || [ "$BIN_OK" -eq 0 ]; then \
        echo "[WARN] Download model RealESRGAN gagal, menggunakan generator sintetis..."; \
        /usr/local/bin/ncnn_generator realesr-animevideov3-x2 2 /app/weights; \
    fi; \
    \
    echo "[INFO] Isi direktori /app/weights:"; \
    ls -la /app/weights/

# ------------------------------------------------------------------------------
# 7. Copy C++ services source tree dan compile binary utama
# ------------------------------------------------------------------------------
COPY services/ /src/services/

RUN cmake -B /src/services/build -S /src/services -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_FLAGS="-O3 -mavx2 -mfma -fopenmp" \
    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && \
    cmake --build /src/services/build --parallel $(nproc)


# --- Stage 2: Hardened Production Runtime ---
FROM ubuntu:24.04 AS runner

ENV DEBIAN_FRONTEND=noninteractive

# ------------------------------------------------------------------------------
# 8. Install runtime shared libraries
# ------------------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    libopencv-dev \
    libcurl4 \
    libgomp1 \
    libvulkan1 \
    mesa-vulkan-drivers \
    vulkan-tools \
    ca-certificates \
    && useradd -m -s /bin/bash -u 1001 visionuser

WORKDIR /app

# ------------------------------------------------------------------------------
# 9. Copy shared libraries (ONNX Runtime & NCNN) ke runtime
# ------------------------------------------------------------------------------
COPY --from=builder /opt/onnxruntime/lib/ /usr/local/lib/
COPY --from=builder /usr/local/lib/libncnn* /usr/local/lib/
RUN ldconfig

# ------------------------------------------------------------------------------
# 10. Copy binary hasil build dan model weights yang sudah diunduh
# ------------------------------------------------------------------------------
COPY --from=builder /src/services/build/bin/vision_service /usr/local/bin/vision_service
COPY --from=builder /usr/local/bin/ncnn_generator /usr/local/bin/ncnn_generator
COPY --from=builder /app/weights/ /app/weights/

# ------------------------------------------------------------------------------
# 11. Prepare directories dan ownership
# ------------------------------------------------------------------------------
RUN mkdir -p /app/ml/AI1/model /app/weights && \
    chown -R visionuser:visionuser /app && \
    echo "[INFO] Model weights di dalam image:" && \
    ls -la /app/weights/

ENV OMP_NUM_THREADS=4 \
    OMP_SCHEDULE=static \
    OMP_PROC_BIND=true \
    LD_LIBRARY_PATH=/usr/local/lib:/opt/onnxruntime/lib:$LD_LIBRARY_PATH \
    HEADLESS=1 \
    QT_QPA_PLATFORM=offscreen

USER visionuser

EXPOSE 8080

ENTRYPOINT ["vision_service"]
