# ==============================================================================
# BawalVision Machine Vision, ONNX ML & NCNN Super-Resolution Engine
# Language: C++20 (OpenCV, ONNX Runtime, NCNN, OpenMP, CMake, Ninja)
# Target OS: Ubuntu 24.04 LTS
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build environment
# ------------------------------------------------------------------------------
FROM ubuntu:25.10 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# 1. Build dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    git \
    pkg-config \
    libopencv-dev \
    libcurl4-openssl-dev \
    libomp-dev \
    libfmt-dev \
    libcpp-httplib-dev \
    nlohmann-json3-dev \
    ca-certificates \
    curl \
    wget \
    tar \
    unzip \
    dos2unix && \
    # 2. ONNX Runtime v1.19.2
    mkdir -p /opt/onnxruntime && \
    curl -fsSL https://github.com/microsoft/onnxruntime/releases/download/v1.19.2/onnxruntime-linux-x64-1.19.2.tgz | \
        tar -xz -C /opt/onnxruntime --strip-components=1 && \
    cp -r /opt/onnxruntime/include/* /usr/local/include/ && \
    cp -r /opt/onnxruntime/lib/* /usr/local/lib/ && \
    # 3. NCNN 20240410
    mkdir -p /opt/ncnn /tmp/ncnn_extracted && \
    curl -fsSL https://github.com/Tencent/ncnn/releases/download/20240410/ncnn-20240410-ubuntu-2204.zip \
        -o /tmp/ncnn.zip && \
    unzip -q /tmp/ncnn.zip -d /tmp/ncnn_extracted && \
    cp -r /tmp/ncnn_extracted/ncnn-20240410-ubuntu-2204/* /opt/ncnn/ && \
    cp -r /opt/ncnn/include/* /usr/local/include/ && \
    cp -r /opt/ncnn/lib/* /usr/local/lib/ && \
    rm -rf /tmp/ncnn.zip /tmp/ncnn_extracted && \
    ldconfig

WORKDIR /src

# 4. Compile NCNN generator utility
COPY ml/ /src/ml/
RUN mkdir -p /app/weights && \
    g++ -std=c++20 -O3 -I /src/ml/include \
        /src/ml/src/ncnn_generator.cpp \
        /src/ml/ncnn_generator.cpp \
        -o /usr/local/bin/ncnn_generator

# 5. Fetch RealESRGAN model weights
COPY scripts/ /src/scripts/
RUN dos2unix /src/scripts/*.sh && \
    chmod +x /src/scripts/fetch_ncnn_model.sh && \
    ALLOW_SYNTHETIC_FALLBACK=1 /src/scripts/fetch_ncnn_model.sh \
        realesr-general-x4v3 \
        /app/weights \
        /usr/local/bin/ncnn_generator \
        4

# 6. Compile main vision binary
COPY services/ /src/services/
RUN cmake -B /src/services/build -S /src/services -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_FLAGS="-O3 -mavx2 -mfma -fopenmp -flto -funroll-loops" \
    -DCMAKE_EXE_LINKER_FLAGS="-flto" \
    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && \
    cmake --build /src/services/build --parallel $(nproc)

# ------------------------------------------------------------------------------
# Stage 2: Production runtime
# ------------------------------------------------------------------------------
FROM ubuntu:25.10 AS runner

ENV DEBIAN_FRONTEND=noninteractive

# 7. Runtime libraries & user creation
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    libopencv-dev \
    libcurl4 \
    libgomp1 \
    libfmt-dev \
    ca-certificates \
    && useradd -m -s /bin/bash -u 1001 visionuser \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 8. Shared libraries
COPY --from=builder /opt/onnxruntime/lib/ /usr/local/lib/
COPY --from=builder /usr/local/lib/libncnn* /usr/local/lib/
RUN ldconfig

# 9. Binaries
COPY --from=builder /src/services/build/bin/vision_service /usr/local/bin/vision_service
COPY --from=builder /usr/local/bin/ncnn_generator /usr/local/bin/ncnn_generator

# 10. Directory & Ownership Setup (Permission Hardening)
# Create full directory structure, copy initial weights, and configure permissions
RUN mkdir -p /app/ml/AI1/model/yolov8s /app/ml/AI1/model/yolov8s_int8 /app/ml/AI1/model/yolov8n /app/ml/AI1/model/yolov8n_int8 /app/weights
COPY --from=builder /app/weights/ /app/weights/

RUN chown -R visionuser:visionuser /app && \
    chmod -R 777 /app/weights

# 11. Environment & Execution
ENV OMP_NUM_THREADS=4 \
    OMP_SCHEDULE=static \
    OMP_PROC_BIND=true \
    OMP_WAIT_POLICY=PASSIVE \
    LD_LIBRARY_PATH=/usr/local/lib:/opt/onnxruntime/lib \
    HEADLESS=1 \
    QT_QPA_PLATFORM=offscreen

USER visionuser

EXPOSE 8080

ENTRYPOINT ["vision_service"]