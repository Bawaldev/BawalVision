# =========================================================================
# Target Chip & Flash Architecture
# =========================================================================
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# =========================================================================
# CPU & FreeRTOS Clock Tuning
# =========================================================================
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# =========================================================================
# 8MB Octal PSRAM Configuration (Crucial for Video Framebuffers)
# =========================================================================
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
# Wi-Fi/LwIP buffers stay in internal SRAM to avoid camera PSRAM contention
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set

# =========================================================================
# Console & System Logging
# UART0 console drives the CH343 USB-UART bridge (/dev/ttyACM0), which is how
# provisioning JSON commands/ACKs reach the host. The native USB-Serial-JTAG
# port is still polled by the provisioning task when connected.
# =========================================================================
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_LOG_COLORS=y

# =========================================================================
# Wi-Fi Stack Optimization (Stabil di 2.4 GHz)
# =========================================================================
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y

# =========================================================================
# LwIP TCP Buffer Tuning (Aman dari EAGAIN & Memory Exhaustion)
# =========================================================================
CONFIG_LWIP_IRAM_OPTIMIZATION=y
# 65535 is the max without LWIP_WND_SCALE (Kconfig range 2440..65535)
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_TCP_RTO_TIME=500

# =========================================================================
# LVGL & UI Display Driver
# =========================================================================
CONFIG_LV_COLOR_16_SWAP=y