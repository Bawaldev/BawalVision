# ==============================================================================
# BawalVision centralized Docker build context exclusions
#
# Used by builds with `context: ..` (see deploy/docker-compose.yml), so paths
# below are relative to the repository root. Only what the target Dockerfile
# actually copies should be sent to the builder.
# ==============================================================================

# Git, CI and repository metadata
.git/
.github/
.gitignore
.gitattributes
.gitleaks.toml
LICENSE
NOTICE
SECURITY.md

# Large directories not needed by the backend image
logs/
assets/
.venv/
frontend/
edge/
docs/
hardware/
examples/
aws-infra/
scripts/

# ML models/datasets are mounted at runtime, not baked into the image.
# Keep only the headers compiled by services/.
ml/
!ml/include/
!ml/include/**

# Documentation and media
*.md
*.png

# Build artifacts and binaries
a.out
build/
services/build/
services/build-tsan/
edge/build/
**/bin/
*.o
*.a
*.so
*.dylib
*.elf
*.bin
*.map
compile_commands.json
*.exe
*.test

# Python and Node artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
node_modules/
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/
*.log

# Datasets, weights and model caches
weights/
*.pt
ml/dataset/
ml/**/dataset/
ml/**/dataset*/
ml/**/runs/
ml/**/yolo_dataset/
.dvc/cache/
.dvc/tmp/

# Local env, caches, temp files and test harness
.env
.env.*
!.env.example
.cache_trash/
tmp/
OUTPUT.md
deploy/test_api.sh

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
