# ==============================================================================
# BawalVision Centralized Docker Build Ignore Specifications
# ==============================================================================

# Git & CI/CD
.git
.gitignore
.gitattributes
.github

# DVC (Data Version Control) Local Cache & Datasets
.dvc/cache/
.dvc/tmp/
ml/dataset/
ml/**/dataset/
ml/**/dataset*/

# Python, Bytecode & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node.js & SvelteKit Web Artifacts
node_modules/
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# C++, CMake & Embedded Edge Build Artifacts
build/
bin/
services/build/
services/build-tsan/
edge/build/
edge/managed_components/
edge/dependencies.lock
*.o
*.a
*.so
*.dylib
*.elf
*.bin
*.map
compile_commands.json

# Go Build Artifacts & Binaries
backend/bin/
backend/server
*.exe
*.test

# IDE, OS & Editor Configuration
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs, Cache & Temporary Directories
.cache_trash/
tmp/
*.log
