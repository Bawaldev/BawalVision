# =========================================================================
# BawalVision Project Root .gitignore
# =========================================================================

# -------------------------------------------------------------------------
# Build & Binary Outputs (C++, Go, Embedded)
# -------------------------------------------------------------------------
build/
bin/
**/build/
**/bin/
cmake-build-*/
_deps/
services/build/
backend/bin/

# CMake Artifacts
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
CMakeUserPresets.json
CMakeLists.txt.user*

# -------------------------------------------------------------------------
# ESP-IDF & PlatformIO Embedded Toolchain (edge/)
# -------------------------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json

# ESP-IDF Generated Files & Dependencies
**/managed_components/
**/sdkconfig
**/sdkconfig.old
!**/sdkconfig.defaults
!**/sdkconfig.defaults.*
**/.component_hash
**/CHECKSUMS.json
idf_py_stderr_*
idf_py_stdout_*
edge/main/include/wifi_credentials.h

# -------------------------------------------------------------------------
# Backend & Databases (backend/)
# -------------------------------------------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/
*.db
*.sqlite
*.sqlite3

# -------------------------------------------------------------------------
# Machine Learning & Python (ml/)
# -------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Model checkpoints berukuran besar (disimpan di cloud / AWS S3 / DVC)
ml/models/*.pt
ml/models/*.pth
ml/models/*.onnx
ml/models/*.engine
!ml/models/.gitkeep

# -------------------------------------------------------------------------
# Datasets & DVC (Data Version Control)
# -------------------------------------------------------------------------
# Scraped & raw image datasets
dataset*/
dataset_mbg_matang/
dataset_tofu_flat/
ml/dataset/
ml/data/
ml/scrap/dataset*/
ml/AI1/dataset/
*.zip
*.tar.gz
*.tar

# DVC internals (cache and local configs)
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# Always track DVC pointer files and DVC project configs
!*.dvc
!.dvc/
!.dvc/config
!.dvc/.gitignore
!.dvcignore
!ml/dataset/**/.gitkeep
!ml/AI1/dataset/**/.gitkeep

# -------------------------------------------------------------------------
# Frontend (frontend/)
# -------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.svelte-kit/
frontend/build/
.npm
package-lock.json
pnpm-lock.yaml
yarn.lock

# -------------------------------------------------------------------------
# IDEs, Editors & Workspaces
# -------------------------------------------------------------------------
.idea/
*.iml
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Environment & Secrets
# -------------------------------------------------------------------------
# Environment, Secrets & Cloud Credentials
# -------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
aws-infra/.aws-sam/

# OS Generated Files
# -------------------------------------------------------------------------
# OS & System Generated Files
# -------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs, Temporary & Gemini Cache
# -------------------------------------------------------------------------
*.log
**/log/
.cache_trash/
OUTPUT.md.bak
*.tmp

usb_stream

OUTPUT.md