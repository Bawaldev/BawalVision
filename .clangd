
Diagnostics:
  UnusedIncludes: None
  ClangTidy:
    Remove:
      - readability-magic-numbers
      - modernize-use-trailing-return-type

---
If:
  PathMatch: .*/edge/.*
CompileFlags:
  CompilationDatabase: edge/build
  Add:
    - -Iedge/main/include
    - -Iedge/main/src
    - -Iedge/main
    - -Iedge/include
    - -Iedge/managed_components/waveshare__esp_lcd_st7735/include
    - -iquoteedge/main/include
    - -iquoteedge/main/src
    - --target=riscv32
    - -std=gnu17
    - -D__XTENSA__=1
    - -DESP_PLATFORM=1
  Remove:
    - -fno-tree-switch-conversion
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -mtext-section-literals
    - -mlongcalls
    - -mlong-calls
    - -mdisable-hardware-atomics
    - -fzero-init-padding-bits=all
    - -fno-malloc-dce
    - -fno-jump-tables
    - -fno-rtti
    - -fno-exceptions
    - --target=xtensa-esp32s3-elf
    - -target
    - xtensa-esp32s3-elf
    - -fno-reorder-blocks

---
If:
  PathMatch: .*/services/.*
CompileFlags:
  CompilationDatabase: services/build
  Add:
    - -std=c++20
    - -Iservices/include
    - -Iml/include
    - -Iinclude
    - -mavx2
    - -mfma
    - -fopenmp
    - -I/opt/onnxruntime/include
    - -I/usr/local/include
    - -I/usr/include/opencv4
    - -I/usr/include/ncnn

---
If:
  PathMatch: .*/ml/.*
CompileFlags:
  Add:
    - -xc++
    - -std=c++20
    - -Iml/include
    - -Iinclude
    - -Iservices/include
    - -Wall
    - -Wextra
    - -mavx2
    - -mfma
    - -fopenmp
    - -I/usr/include/opencv4
    - -I/usr/include/ncnn