---
Diagnostics:
  UnusedIncludes: None

---
If:
  PathMatch: edge/.*
CompileFlags:
  CompilationDatabase: edge/build
  Remove:
    - -fno-tree-switch-conversion
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -mtext-section-literals
    - -mlongcalls
    - -mlong-calls
    - -mdisable-hardware-atomics
    - -fzero-init-padding-bits=all
    - -fno-malloc-dce
    - -fno-jump-tables

---
If:
  PathMatch: services/.*
CompileFlags:
  CompilationDatabase: services/build
  Add:
    - -std=c++20
    - -Iservices/include