CompileFlags:
  CompilationDatabase: services/build

Diagnostics:
  UnusedIncludes: None
  ClangTidy:
    Remove:
      - readability-magic-numbers
      - modernize-use-trailing-return-type

---
If:
  PathMatch: .*/edge/.*
CompileFlags:
  CompilationDatabase: edge/build
  Remove:
    - -fno-tree-switch-conversion
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -mtext-section-literals
    - -mlongcalls
    - -mlong-calls
    - -mdisable-hardware-atomics
    - -fzero-init-padding-bits=all
    - -fno-malloc-dce
    - -fno-jump-tables
    - -fno-rtti
    - -fno-exceptions

---
If:
  PathMatch: .*/services/.*
CompileFlags:
  CompilationDatabase: services/build
  Add:
    - -std=c++20
    - -Iservices/include
    - -Iml/include
    - -Iinclude
    - -mavx2
    - -mfma
    - -fopenmp
    - -I/opt/onnxruntime/include
    - -I/usr/local/include
    - -I/usr/include/opencv4

---
If:
  PathMatch: .*/ml/.*
CompileFlags:
  Add:
    - -xc++
    - -std=c++20
    - -Iml/include
    - -Iinclude
    - -Iservices/include
    - -Wall
    - -Wextra
    - -mavx2
    - -mfma
    - -fopenmp